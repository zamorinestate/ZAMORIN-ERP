# Zamorin Cafe ERP backend environment template.
# Copy this file to .env for local development only.
# Configure the same keys in Render for production. Never commit real values.

NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# MongoDB Atlas connection. Replace every placeholder locally or in Render.
MONGODB_URI=mongodb+srv://DB_USER:DB_PASSWORD@ATLAS_CLUSTER_HOST/zamorin_cafe_erp?retryWrites=true&w=majority
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=0

# Distributed Redis (rate limiting, locks, job coordination).
# REQUIRED in production: NODE_ENV=production forces the redis adapter and boot
# fails fast with CLUSTER_REDIS_CONFIG_MISSING when no URL is configured.
# Local development falls back to in-memory Maps when left unset.
# Production example: redis://default:PASSWORD@HOST:6379 (rediss:// for TLS)
# REDIS_URL=

# Comma-separated exact frontend origins. Wildcards are rejected.
# Development example: http://localhost:3000
# Production example: https://your-zamorin-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# Generate unique production secrets. Do not reuse or commit them.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
SESSION_ABSOLUTE_TTL_DAYS=7
SESSION_IDLE_TIMEOUT_MINUTES=30
STEP_UP_AUTH_MAX_AGE_MINUTES=10
MFA_ENCRYPTION_KEY=replace-with-a-secure-random-64-character-hex-key

# Initial seed account values. Replace before running the seed command.
INITIAL_ORGANISATION_ID=ZAMORIN
INITIAL_MASTER_NAME=Zamorin Master
INITIAL_MASTER_EMAIL=master@example.com
INITIAL_MASTER_PASSWORD=ReplaceWithStrongPassword123!


# Password reset delivery. Local logging must never be enabled in production.
PASSWORD_RESET_DEV_LOG_CODE=false

# Private binary storage. Local is development-only; production requires cloudinary.
PRIVATE_STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Business Document Storage (MongoDB Atlas GridFS).
# Production canonical storage uses MongoDB Atlas GridFS (zamorinDocuments bucket).
# Ephemeral container filesystem and S3/R2 are not used.
DOCUMENT_STORAGE_PROVIDER=gridfs
DOCUMENT_GRIDFS_BUCKET=zamorinDocuments
DOCUMENT_STORAGE_MAX_BYTES=15728640
# Local development only override:
# DOCUMENT_STORAGE_ROOT=./uploads/dev_documents

# Trusted reverse-proxy configuration (comma-separated IP addresses, CIDR blocks, or keywords: loopback, linklocal, uniquelocal)
# Defaults to: loopback,linklocal,uniquelocal. Example with custom load balancers:
# TRUSTED_PROXY_CIDRS=loopback,linklocal,uniquelocal,198.51.100.0/24

# Authentication rate limiting thresholds (optional overrides)
# RATE_LIMIT_MAX=50000
# AUTH_RATE_LIMIT_IP_MAX=50
# AUTH_RATE_LIMIT_ACCOUNT_MAX=10
